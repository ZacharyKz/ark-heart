<!-- pages/reports/reports.wxml — 我的报告 -->
<view class="page">
  <view class="status-bar-placeholder"></view>

  <view class="brand-header">
    <view class="header-left">
      <image class="header-logo" src="/images/logo.svg" mode="aspectFit" />
      <text class="header-title">The Ark Heart</text>
    </view>
    <view class="header-menu" bindtap="onMenuTap">
      <view class="menu-dot"></view><view class="menu-dot"></view><view class="menu-dot"></view>
    </view>
  </view>

  <!-- Banner -->
  <view class="reports-banner">
    <image src="/images/reports-banner.jpg" mode="aspectFill" class="banner-img" />
    <view class="banner-overlay">
      <text class="banner-title">我的报告</text>
      <text class="banner-sub">查看您的咨询与成长记录</text>
    </view>
  </view>

  <!-- 概览统计 -->
  <view class="rpt-section">
    <text class="rpt-section-title">我的概览</text>
    <view class="rpt-stats-row">
      <view class="rpt-stat-card" wx:for="{{stats}}" wx:key="label">
        <view class="stat-icon">
          <image src="{{item.icon}}" mode="aspectFit" class="stat-icon-img" />
        </view>
        <view class="stat-info">
          <text class="stat-num">{{item.num}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 报告列表 -->
  <view class="rpt-section">
    <view class="rpt-list-header">
      <text class="rpt-list-title">报告列表</text>
      <view class="rpt-list-filter" bindtap="onFilterTap">
        <text>筛选</text>
        <image src="/images/chevron-down.svg" mode="aspectFit" class="filter-arrow" />
      </view>
    </view>

    <view wx:if="{{reports.length > 0}}">
      <view class="rpt-entry" wx:for="{{reports}}" wx:key="_id" bindtap="onTapReport" data-id="{{item._id}}">
        <view class="entry-thumb">
          <image src="{{item.thumb || '/images/placeholder.svg'}}" mode="aspectFill" class="entry-thumb-img" />
        </view>
        <view class="entry-body">
          <text class="entry-title">{{item.title}}</text>
          <view class="entry-tag tag-{{item.tagClass}}">{{item.tagText}}</view>
          <text class="entry-meta">咨询报告 · {{item.dateText}}</text>
        </view>
        <view class="entry-chevron">
          <image src="/images/chevron-right.svg" mode="aspectFit" class="chevron-icon" />
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-text">暂无报告</text>
    </view>
  </view>

  <tab-bar current="{{2}}" />
</view>
