/* pages/booking/booking.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 48rpx;
}

.status-bar-placeholder {
  height: var(--status-bar-height, 44px);
  background: var(--bg);
}

/* Header */
.header-row {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  height: 88rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -16rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.header-spacer {
  width: 64rpx;
}

/* Content */
.content-body {
  padding: 0 32rpx 48rpx;
}

/* 表单卡片 */
.form-card {
  background: var(--card-bg);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 36rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #E74C3C;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  display: block;
}

/* 单选组 */
.radio-group {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.radio-group.vertical {
  flex-direction: column;
}

.radio-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: var(--bg);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 200ms ease;
}

.radio-item.active {
  background: var(--green-light);
  color: var(--green-dark);
  border-color: var(--green);
  font-weight: 600;
}

.radio-group.vertical .radio-item {
  flex-direction: row;
  justify-content: flex-start;
  border-radius: 16rpx;
  padding: 24rpx;
}

.radio-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.radio-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 选择器 */
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.placeholder {
  color: var(--text-tertiary);
}

.picker-arrow {
  width: 32rpx;
  height: 32rpx;
  transform: rotate(90deg);
  opacity: 0.4;
}

/* 协议确认 */
.agreement-check {
  margin-bottom: 32rpx;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: var(--green);
  border-color: var(--green);
}

.check-icon {
  width: 24rpx;
  height: 24rpx;
}

.agreement-label {
  font-size: 25rpx;
  color: var(--text-secondary);
}

.link {
  color: var(--green);
}

/* 提交按钮 */
.btn-submit {
  width: 100%;
  height: 96rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 16rpx;
}

.btn-submit[disabled] {
  background: #C8C8C8;
  color: #FFFFFF;
}

.submit-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  display: block;
  line-height: 1.6;
}

/* 咨询方向大字居中 */
.direction-item { justify-content: center !important; }
.direction-label { font-size: 30rpx; font-weight: 600; }
.direction-item.active .direction-label { color: var(--green-dark); }
