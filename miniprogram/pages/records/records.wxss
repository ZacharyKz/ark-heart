/* pages/records/records.wxss */
.page { min-height: 100vh; background: var(--bg); padding-bottom: 110rpx; }

.status-bar-placeholder { height: var(--status-bar-height, 44px); background: var(--bg); }

/* Header */
.brand-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40rpx; height: 88rpx;
}
.header-left { display: flex; align-items: center; gap: 16rpx; }
.header-logo { width: 52rpx; height: 48rpx; }
.header-title { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.header-menu { display: flex; flex-direction: column; gap: 6rpx; padding: 16rpx; margin-right: -16rpx; }
.menu-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: var(--text-primary); }

.page-brand-title { font-size: 44rpx; font-weight: 700; color: var(--text-primary); padding: 32rpx 40rpx 4rpx; display: block; }
.page-brand-subtitle { font-size: 30rpx; font-weight: 500; color: var(--text-secondary); padding: 0 40rpx 32rpx; display: block; }

/* 筛选 */
.filter-scroll { white-space: nowrap; }
.filter-pills { display: flex; gap: 16rpx; padding: 0 32rpx 28rpx; }
.filter-pill {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 10rpx 28rpx; border-radius: 36rpx; font-size: 24rpx; font-weight: 500;
  background: #F0EFEB; color: var(--text-secondary);
}
.filter-pill.active { background: var(--green); color: #FFFFFF; }

/* 卡片列表 */
.card-list { padding: 0 32rpx 48rpx; }
.record-card {
  display: flex; background: #fff; border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow); margin-bottom: 24rpx; overflow: hidden;
}
.card-thumb { width: 210rpx; min-height: 240rpx; flex-shrink: 0; }
.thumb-img { width: 100%; height: 100%; }
.card-body { flex: 1; padding: 24rpx 28rpx; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
.card-top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 12rpx; }
.card-project { font-size: 26rpx; font-weight: 600; color: var(--text-primary); flex: 1; }
.card-badge { font-size: 22rpx; font-weight: 500; padding: 4rpx 16rpx; border-radius: 12rpx; white-space: nowrap; }
.badge-pending { background: var(--badge-pending-bg); color: var(--badge-pending-text); }
.badge-confirmed { background: var(--badge-confirmed-bg); color: var(--badge-confirmed-text); }
.badge-done { background: var(--badge-done-bg); color: var(--badge-done-text); }
.badge-cancelled { background: var(--badge-cancelled-bg); color: var(--badge-cancelled-text); }
.card-info { font-size: 23rpx; color: var(--text-secondary); line-height: 1.7; }
.info-line { display: flex; align-items: center; gap: 8rpx; }
.info-icon { width: 24rpx; height: 24rpx; flex-shrink: 0; opacity: 0.6; }
.card-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.card-id { font-size: 22rpx; color: var(--text-tertiary); }
.card-btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--green-light); color: var(--green-dark);
  font-size: 24rpx; font-weight: 500; padding: 10rpx 24rpx; border-radius: 16rpx;
}

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-img { width: 240rpx; height: 240rpx; opacity: 0.4; margin-bottom: 32rpx; }
.empty-text { font-size: 28rpx; color: var(--text-tertiary); }
