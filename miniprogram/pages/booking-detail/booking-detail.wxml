<!-- pages/booking-detail/booking-detail.wxml — 预约详情 -->
<view class="page">
  <view class="status-bar-placeholder"></view>

  <view class="header-row">
    <view class="back-btn" bindtap="onBack">
      <!-- 返回按钮 -->
<image src="/images/chevron-left.svg" mode="aspectFit" class="back-icon" />
    </view>
    <text class="header-title">预约详情</text>
    <view class="header-spacer"></view>
  </view>

  <view class="content-body">
    <view class="detail-card">
      <view class="detail-status-row">
        <view class="detail-badge badge-{{detail.status}}">{{detail.statusLabel}}</view>
      </view>

      <view class="detail-item" wx:for="{{detailFields}}" wx:key="label">
        <text class="detail-label">{{item.label}}</text>
        <text class="detail-value">{{item.value || '待填写'}}</text>
      </view>

      <view class="detail-item" wx:if="{{detail.status === 'confirmed'}}">
        <text class="detail-label">预约编号</text>
        <text class="detail-value mono">{{detail._id}}</text>
      </view>
    </view>

    <!-- 取消按钮 -->
    <view wx:if="{{detail.status === 'pending'}}" class="cancel-area">
      <button class="btn-cancel" bindtap="onCancel">取消预约</button>
    </view>
  </view>
</view>
