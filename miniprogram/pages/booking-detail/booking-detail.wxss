/* pages/booking-detail/booking-detail.wxss */
.page { min-height: 100vh; background: var(--bg); padding-bottom: 48rpx; }
.status-bar-placeholder { height: var(--status-bar-height, 44px); background: var(--bg); }

.header-row { display: flex; align-items: center; padding: 0 40rpx; height: 88rpx; }
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin-left: -16rpx; }
.back-icon { width: 40rpx; height: 40rpx; }
.header-title { flex: 1; font-size: 36rpx; font-weight: 600; color: var(--text-primary); text-align: center; }
.header-spacer { width: 64rpx; }

.content-body { padding: 0 32rpx 48rpx; }

.detail-card { background: #fff; border-radius: 28rpx; box-shadow: 0 4rpx 24rpx var(--shadow); padding: 40rpx 32rpx; margin-bottom: 32rpx; }

.detail-status-row { margin-bottom: 32rpx; }
.detail-badge { display: inline-flex; font-size: 26rpx; font-weight: 600; padding: 8rpx 24rpx; border-radius: 16rpx; }
.badge-pending { background: var(--badge-pending-bg); color: var(--badge-pending-text); }
.badge-confirmed { background: var(--badge-confirmed-bg); color: var(--badge-confirmed-text); }
.badge-done { background: var(--badge-done-bg); color: var(--badge-done-text); }
.badge-cancelled { background: var(--badge-cancelled-bg); color: var(--badge-cancelled-text); }

.detail-item { display: flex; justify-content: space-between; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid var(--border); }
.detail-item:last-child { border-bottom: none; }
.detail-label { font-size: 28rpx; color: var(--text-secondary); flex-shrink: 0; margin-right: 32rpx; }
.detail-value { font-size: 28rpx; color: var(--text-primary); font-weight: 500; text-align: right; }
.mono { font-family: 'Courier New', monospace; font-size: 24rpx; }

.cancel-area { display: flex; justify-content: center; }
.btn-cancel { width: 60%; height: 88rpx; background: #FFFFFF; color: #991B1B; font-size: 30rpx; border: 2rpx solid #FECACA; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; }
.btn-cancel:active { background: #FEF2F2; }
