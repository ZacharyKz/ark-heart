/* pages/home/home.wxss */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 110rpx;
}

/* 状态栏占位 */
.status-bar-placeholder {
  height: var(--status-bar-height, 44px);
  background: var(--bg);
}

/* Header */
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
  height: 88rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-logo {
  width: 52rpx;
  height: 48rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 0.6rpx;
}

.header-menu {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 16rpx;
  margin-right: -16rpx;
  border-radius: 16rpx;
}

.menu-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--text-primary);
}

/* Banner */
.banner-area {
  width: 100%;
  height: 390rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* Content Body */
.content-body {
  padding: 0 32rpx 48rpx;
}

/* 毛玻璃服务卡片 */
.service-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  margin-top: -56rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.service-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.service-item + .service-item {
  border-top: 1rpx solid var(--border);
}

.service-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.service-text {
  flex: 1;
}

.service-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.service-subtitle {
  font-size: 21rpx;
  color: var(--text-secondary);
  line-height: 1.4;
  margin-top: 4rpx;
}

.service-chevron {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.5;
}

/* 协议提示 */
.agreement-section {
  margin-bottom: 40rpx;
}

.agreement-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow);
  margin-bottom: 32rpx;
}

.agreement-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.agreement-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.agreement-text {
  font-size: 25rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.link {
  color: var(--green);
}

.intro-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.intro-strong {
  color: var(--text-primary);
  font-weight: 600;
}

/* 关于我们 */
.about-section {
  background: var(--card-bg);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  padding: 40rpx;
  margin-bottom: 48rpx;
}

.about-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  display: block;
}

.about-flex {
  display: flex;
  gap: 32rpx;
  align-items: stretch;
}

.about-text-side {
  flex: 1.3;
}

.about-text {
  font-size: 25rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.about-image-side {
  flex: 0.85;
}

.about-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

/* 预约流程 */
.flow-section {
  background: var(--card-bg);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx var(--shadow);
  padding: 40rpx 32rpx 48rpx;
  margin-bottom: 48rpx;
}

.flow-header {
  margin-bottom: 48rpx;
}

.flow-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.flow-subtitle {
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.flow-steps {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  padding: 0 8rpx;
}

.flow-line-bg {
  position: absolute;
  top: 56rpx;
  left: 56rpx;
  right: 56rpx;
  height: 4rpx;
  background: var(--border);
  z-index: 0;
}

.flow-line-fill {
  position: absolute;
  top: 56rpx;
  left: 56rpx;
  right: calc(30% + 56rpx);
  height: 4rpx;
  background: var(--green-muted);
  z-index: 1;
}

.flow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 2;
  flex: 1;
}

.flow-circle {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--green-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.flow-circle.final {
  width: 116rpx;
  height: 116rpx;
  box-shadow: 0 6rpx 24rpx rgba(107, 158, 125, 0.35);
}

.flow-icon {
  width: 60rpx;
  height: 60rpx;
}

.flow-circle.final .flow-icon {
  width: 64rpx;
  height: 64rpx;
}

.flow-step-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
  text-align: center;
}

.flow-step-label.final {
  color: var(--text-primary);
  font-weight: 600;
}

/* 底部预约按钮 */
.bottom-cta {
  display: flex;
  justify-content: center;
}

.btn-booking {
  width: 100%;
  height: 96rpx;
  background: var(--green);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-booking:active {
  background: var(--green-dark);
}
