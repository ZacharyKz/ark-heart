/* app.wxss — 全局样式 & Design Tokens */
/* 基于 design-tokens.md 自动生成 */

page {
  /* 色彩 */
  --green: #6B9E7D;
  --green-light: #E8F0EA;
  --green-dark: #5A8A6C;
  --green-muted: #8FB89E;

  /* 背景 */
  --bg: #F7F6F2;
  --card-bg: #FFFFFF;

  /* 文字 */
  --text-primary: #2D2D2D;
  --text-secondary: #6B6B6B;
  --text-tertiary: #999999;

  /* 边框 & 阴影 */
  --border: #EDEDEB;
  --shadow: rgba(0, 0, 0, 0.04);
  --tab-bar-border: #F0EFEB;

  /* 功能色 */
  --badge-done-bg: #F1F5F9;
  --badge-done-text: #64748B;
  --badge-confirmed-bg: #E8F0EA;
  --badge-confirmed-text: #5A8A6C;
  --badge-pending-bg: #FEF3C7;
  --badge-pending-text: #A16207;
  --badge-cancelled-bg: #FEF2F2;
  --badge-cancelled-text: #991B1B;

  /* 基础样式 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
    'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial,
    sans-serif;
  font-size: 14px;
  color: var(--text-primary);
  background-color: var(--bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 全局工具类 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  background: var(--card-bg);
  border-radius: 12px;
  box-shadow: 0 1px 4px var(--shadow);
}

.card-14 {
  border-radius: 14px;
}

.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-green { color: var(--green); }

/* 动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tabFadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
