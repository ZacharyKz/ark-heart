/* 专业报告排版 */
.page { min-height: 100vh; background: var(--bg); padding-bottom: 48rpx; }
.status-bar-placeholder { height: var(--status-bar-height, 44px); background: var(--bg); }

.header-row { display: flex; align-items: center; padding: 0 40rpx; height: 88rpx; }
.back-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; margin-left: -16rpx; }
.back-icon { width: 40rpx; height: 40rpx; }
.header-title { flex: 1; font-size: 36rpx; font-weight: 600; color: var(--text-primary); text-align: center; }
.header-spacer { width: 64rpx; }

.content-body { padding: 0 32rpx 48rpx; }

/* 报告头部 */
.rpt-header { background: #fff; border-radius: 28rpx; padding: 40rpx 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx var(--shadow); }
.rpt-main-title { font-size: 38rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 20rpx; text-align: center; }
.rpt-meta { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; margin-bottom: 12rpx; }
.rpt-no { font-size: 24rpx; color: var(--text-tertiary); }
.rpt-date { font-size: 24rpx; color: var(--text-secondary); }
.rpt-duration { font-size: 24rpx; color: var(--text-secondary); }
.rpt-method { font-size: 24rpx; color: var(--text-secondary); }
.rpt-counselor { font-size: 26rpx; color: var(--text-primary); font-weight: 500; display: block; }
.rpt-divider { height: 1rpx; background: var(--border); margin: 12rpx 0; }

/* 报告章节 */
.rpt-section { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx var(--shadow); }
.rpt-section-title { font-size: 30rpx; font-weight: 700; color: var(--green-dark); display: block; margin-bottom: 20rpx; padding-bottom: 16rpx; border-bottom: 2rpx solid var(--green-light); }
.rpt-text { font-size: 28rpx; color: var(--text-primary); line-height: 1.9; white-space: pre-wrap; }

/* 报告尾部 */
.rpt-footer { padding: 20rpx 32rpx 40rpx; }
.rpt-footer .rpt-divider { margin-bottom: 20rpx; }
.rpt-footer-text { font-size: 24rpx; color: var(--text-secondary); display: block; margin-bottom: 8rpx; }
.rpt-footer-note { font-size: 22rpx; color: var(--text-tertiary); font-style: italic; margin-top: 20rpx; display: block; }

.loading-wrap { text-align: center; padding-top: 200rpx; color: var(--text-tertiary); }
